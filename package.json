{
  "name": "placement-tracker-root",
  "version": "1.0.0",
  "private": true,
  "description": "Student Placement Management System (MERN Stack)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm --prefix backend install",
    "start": "npm --prefix backend start",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "build:frontend": "npm --prefix frontend run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "placement-tracker",
    "mern",
    "react",
    "express",
    "mongodb",
    "nodejs",
    "tailwind"
  ],
  "author": "Antigravity Senior Full-Stack Engineer"
}
