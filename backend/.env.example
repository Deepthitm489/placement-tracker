# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your MongoDB Atlas cluster string:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/placement_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/placement_tracker

# JWT Secret & Expiry
JWT_SECRET=super_secret_placement_tracker_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
